{
  "name": "raincoil",
  "version": "0.3.0",
  "private": true,
  "description": "An original chromatic survival arcade game",
  "author": "Raincoil",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node tools/make-icon.mjs && electron .",
    "test": "node --test tests/*.test.mjs",
    "build:windows": "node tools/make-icon.mjs && electron-builder --win portable --x64",
    "build:web": "node tools/package.mjs Web",
    "build:source": "node tools/package.mjs Source",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "games.raincoil.arcade",
    "productName": "Raincoil",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "index.html",
      "src/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Raincoil-${version}-Windows-x64.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Raincoil-${version}-Windows-x64.exe"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
