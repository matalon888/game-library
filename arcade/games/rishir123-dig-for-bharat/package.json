{
  "name": "dig-for-bharat",
  "productName": "Dig for Bharat",
  "version": "1.0.0",
  "description": "A voxel excavation game. Read the clue, find the landmark, cut down to the right layer.",
  "main": "electron/main.cjs",
  "author": "Archaeological Survey field trainee",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node electron/launch.cjs",
    "dev": "node electron/launch.cjs --dev",
    "web": "python3 serve.py",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "selftest": "node electron/launch.cjs --selftest",
    "langcheck": "node tools/langcheck.cjs"
  },
  "build": {
    "appId": "io.orionac.digforbharat",
    "productName": "Dig for Bharat",
    "files": [
      "lang/**",
      "electron/**",
      "engine/**",
      "src/**",
      "src3d/**",
      "vendor/**",
      "index.html",
      "section.html",
      "styles.css",
      "styles-trench.css",
      "!build/icon.html"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "icon": "build/icon.png"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}